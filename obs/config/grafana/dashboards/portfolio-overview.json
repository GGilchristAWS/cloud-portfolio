{
  "uid": "portfolio-overview",
  "title": "Portfolio overview",
  "description": "Golden signals, traces, logs and monitoring-stack health for the portfolio app.",
  "tags": [
    "portfolio",
    "red",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "## Portfolio \u00b7 live production telemetry\nMetrics, traces and logs from the app at **portfolio.geoffgilchrist.com**, collected with OpenTelemetry and stored in Prometheus, Tempo and Loki running beside it on ECS Fargate. Click a dot on the latency graph to open that request's trace; every log line links to its trace too."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "description": "All app requests per second (health checks excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "portfolio:requests:rate1m",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#58a6ff",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95% of requests finish faster than this. Green under 300 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "portfolio:latency:p95_1m",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3fb950",
                "value": null
              },
              {
                "color": "#d29922",
                "value": 0.3
              },
              {
                "color": "#f85149",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "Share of requests answered with a 5xx status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "portfolio:errors:ratio1m",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3fb950",
                "value": null
              },
              {
                "color": "#d29922",
                "value": 0.01
              },
              {
                "color": "#f85149",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Availability",
      "description": "Non-5xx responses over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{service_name=\"portfolio-app\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(http_server_request_duration_seconds_count{service_name=\"portfolio-app\"}[$__range])), 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f85149",
                "value": null
              },
              {
                "color": "#d29922",
                "value": 0.99
              },
              {
                "color": "#3fb950",
                "value": 0.995
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Running tasks",
      "description": "App containers currently reporting telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(target_info{job=\"portfolio-app\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f85149",
                "value": null
              },
              {
                "color": "#3fb950",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Deployed version",
      "description": "Git commit of the running image.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (service_version) (target_info{job=\"portfolio-app\"})",
          "legendFormat": "{{service_version}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#58a6ff",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "row",
      "title": "Traffic and latency",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by route",
      "description": "Request rate per route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"portfolio-app\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Response time percentiles. Dots are exemplars: click one to open that request's trace.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"portfolio-app\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"portfolio-app\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"portfolio-app\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3fb950"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d29922"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f85149"
                }
              }
            ]
          }
        ]
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "heatmap",
      "title": "Latency distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How request durations are spread over time; brighter cells hold more requests.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(http_server_request_duration_seconds_bucket{service_name=\"portfolio-app\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "exponent": 0.5,
          "steps": 64
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Responses by status code",
      "description": "2xx success, 4xx client errors (e.g. missing pages), 5xx server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"portfolio-app\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "2.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3fb950"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "3.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#58a6ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "4.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d29922"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f85149"
                }
              }
            ]
          }
        ]
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Traces and logs",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Latest requests traced end to end. Click a trace ID to see its spans.",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "query": "{resource.service.name=\"portfolio-app\"}",
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "logs",
      "title": "App logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Structured logs from the app; lines written during a request carry its trace ID.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"portfolio-app\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Monitoring stack health",
      "collapsed": false,
      "panels": [],
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "state-timeline",
      "title": "Component up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every monitoring component is scraped by Prometheus, including Prometheus itself.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#f85149",
                "value": null
              },
              {
                "color": "#3fb950",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down"
                },
                "1": {
                  "text": "up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 17,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Telemetry flowing through the collector",
      "description": "Items per second accepted by the OpenTelemetry Collector; anything refused is shown in red.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[$__rate_interval]))",
          "legendFormat": "metric points",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[$__rate_interval]))",
          "legendFormat": "log records",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(otelcol_receiver_refused_spans[$__rate_interval]) + rate(otelcol_receiver_refused_metric_points[$__rate_interval]) + rate(otelcol_receiver_refused_log_records[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "D"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
